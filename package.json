{
  "name": "rappiopedia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rappiopedia: Finnish internet culture encyclopedia with Rappioverse 3D research graph",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build",
    "images": "python scripts/process_images.py --download --update-data",
    "test:images": "python -m unittest discover -s tests -p 'test_images.py'"
  },
  "devDependencies": {
    "vite": "6.3.6"
  }
}
